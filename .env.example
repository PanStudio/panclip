# PanClip reads only its process environment; it does not load a .env file.
# Set these in your MCP client's server entry (the "env" block) or your shell.
# Every value below is the default unless marked as an example.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Data directory, absolute path. Default: $XDG_DATA_HOME/panclip, else
# ~/.local/share/panclip. The --data-dir flag overrides it.
# PANCLIP_DATA_DIR=/home/me/.local/share/panclip   (example)

# Longest clip accepted, in characters (1 to 1000000).
PANCLIP_MAX_CONTENT_CHARS=50000
# Clips kept; the oldest are deleted after each write. 0 keeps all.
PANCLIP_MAX_CLIPS=10000
# Clips older than this many days are deleted after each write. 0 keeps all.
PANCLIP_MAX_AGE_DAYS=0

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Local servers on a loopback address are probed in the background at start.
# A base pointing at another host is ignored unless cloud use is allowed.
LMSTUDIO_API_BASE=http://localhost:1234
OLLAMA_API_BASE=http://localhost:11434
VLLM_API_BASE=http://localhost:8000
TEXTGEN_API_BASE=http://localhost:5000
KOBOLDCPP_API_BASE=http://localhost:5001

# Cloud providers and non-loopback servers are used only when this is true
# (or with the --allow-cloud flag). Clip text is then sent to them.
PANCLIP_ALLOW_CLOUD=false
# Read only when PANCLIP_ALLOW_CLOUD is true:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# COHERE_API_KEY=
# GROQ_API_KEY=

# Per-request timeout in seconds and retries for provider calls.
PANCLIP_REQUEST_TIMEOUT=30
PANCLIP_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Cache and logging
# ---------------------------------------------------------------------------
# Optional shared search cache. Unset means an in-process cache. Put the
# password in the URL; cached results contain clip text. Non-loopback Redis
# hosts require PANCLIP_ALLOW_CLOUD=true.
# PANCLIP_REDIS_URL=redis://:password@localhost:6379/0   (example)

# Log level for stderr: DEBUG, INFO, WARNING or ERROR.
PANCLIP_LOG_LEVEL=WARNING
