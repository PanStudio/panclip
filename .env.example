# PanClip MCP Server - Environment Configuration Template
# Copy this file to .env and configure your AI providers

# ============================================================================
# LOCAL AI SERVERS (Automatically detected if running)
# ============================================================================

# LM Studio (typically runs on port 1234)
LMSTUDIO_API_BASE=http://localhost:1234

# Ollama (typically runs on port 11434)
OLLAMA_API_BASE=http://localhost:11434

# vLLM Server
VLLM_API_BASE=http://localhost:8000

# Text Generation WebUI
TEXTGEN_API_BASE=http://localhost:5000

# ============================================================================
# CLOUD AI PROVIDERS (Add any API keys you have)
# ============================================================================

# OpenAI (recommended for best embeddings)
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google AI / Vertex AI
GOOGLE_API_KEY=
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=

# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-02-01

# Cohere
COHERE_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Groq (fast inference)
GROQ_API_KEY=

# Hugging Face
HUGGINGFACE_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Perplexity
PERPLEXITYAI_API_KEY=

# Replicate
REPLICATE_API_TOKEN=

# ============================================================================
# MODEL PREFERENCES (Optional - will auto-select best available)
# ============================================================================

# Preferred models (will use if available, otherwise auto-select)
PANCLIP_PREFERRED_EMBEDDING_MODEL=
PANCLIP_PREFERRED_CHAT_MODEL=

# Model routing strategy: simple-shuffle, least-busy, usage-based-routing, latency-based-routing
PANCLIP_ROUTING_STRATEGY=latency-based-routing

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

# Cache backend: auto, redis, memory
PANCLIP_CACHE_BACKEND=auto

# Redis settings (if using Redis cache)
PANCLIP_REDIS_HOST=localhost
PANCLIP_REDIS_PORT=6379
PANCLIP_REDIS_PASSWORD=
PANCLIP_REDIS_DB=0

# Cache TTL in seconds
PANCLIP_EMBEDDING_CACHE_TTL=3600
PANCLIP_CHAT_CACHE_TTL=300

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================

# Request timeout in seconds
PANCLIP_REQUEST_TIMEOUT=30

# Number of retries for failed requests
PANCLIP_MAX_RETRIES=3

# Cooldown time for failed providers (seconds)
PANCLIP_COOLDOWN_TIME=60

# Enable pre-call checks (validates context window before requests)
PANCLIP_ENABLE_PRE_CALL_CHECKS=true

# ============================================================================
# AGENT MODE CONFIGURATION
# ============================================================================

# Auto-capture settings for AI agents
PANCLIP_AGENT_AUTO_CAPTURE=true
PANCLIP_AGENT_MIN_CONTENT_LENGTH=50
PANCLIP_AGENT_MAX_CONTENT_LENGTH=10000

# Content filtering for agents
PANCLIP_AGENT_FILTER_CODE=true
PANCLIP_AGENT_FILTER_DOCS=true
PANCLIP_AGENT_FILTER_CONFIGS=true

# ============================================================================
# STORAGE SETTINGS
# ============================================================================

# Local storage path for LanceDB
PANCLIP_STORAGE_PATH=~/.panclip/lancedb

# Maximum clips to store
PANCLIP_MAX_CLIPS=100000

# ============================================================================
# DEBUG & LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
PANCLIP_LOG_LEVEL=INFO

# Enable detailed AI provider logging
PANCLIP_AI_DEBUG=false

# Enable performance metrics
PANCLIP_ENABLE_METRICS=true